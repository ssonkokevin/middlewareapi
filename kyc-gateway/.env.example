# KYC Verification API Gateway — environment variables (v2.0.0)

# ---------------------------------------------------------------- General
DEBUG=true
TIMEOUT=60
# Public URL used by the OpenAPI document and Swagger UI. Change this only
# when the service is moved behind a DNS name, reverse proxy, or TLS endpoint.
PUBLIC_BASE_URL=http://10.33.33.30:8001

# Private UCC endpoint; vendors must use PUBLIC_BASE_URL instead. The current
# provider adapter remains simulated until UCC forwarding is implemented.
UCC_BASE_URL=https://192.168.5.18

# -------------------------------------------------------- Upstream (TBD)
# No production or test URL has been confirmed yet for any provider. Leave
# these blank until UCC/NIRA/UNHCR/NCIC/URSB provide the real endpoints. The
# gateway runs fully self-contained using the SQLite-backed store and
# simulated provider logic (app/services/) while these are empty.
KYC_UPSTREAM_URL=
NIRA_VALIDATE_URL=
UNHCR_VALIDATE_URL=
NCIC_VALIDATE_URL=
URSB_VALIDATE_URL=

# ---------------------------------------------------------------- Auth
# Comma-separated list of accepted API keys (X-API-Key header). Each key
# identifies a calling MNO.
KYC_API_KEYS=dev-local-key

# ------------------------------------------------------------- Policy
# verification_reference lifetime — 24 hours per spec (NOT the old 10-minute
# eligibility_token TTL, which is removed entirely in 2.0.0).
VERIFICATION_REFERENCE_TTL_HOURS=24.0
# Documented gap: the 2.0.0 schema has no capture-timestamp field, only an
# opaque transaction_id, so this window cannot actually be enforced yet —
# see app/services/verification_service.py.
NIRA_FRESHNESS_WINDOW_SECONDS=30
GLOBAL_INDIVIDUAL_OWNERSHIP_LIMIT=10
GLOBAL_CORPORATE_OWNERSHIP_LIMIT=100
MAX_BATCH_SIZE=1000

# Feature flag for the two IndividualIdType values removed in 2.0.0 (ASYLUM,
# DIPLOMAT ID). Leave false until UCC issues the migration note with
# replacement values — do not hardcode a guess.
LEGACY_ID_TYPES_ENABLED=false

# ----------------------------------------------------------- Persistence
# SQLite file backing verification_references/registrations/batch jobs.
# Deliberately not in-memory — see app/services/db.py for why.
SQLITE_PATH=kyc_gateway.db

# ------------------------------------------------------------- Webhook
# Outbound batch-completion notification. Leave blank to disable (a
# supported configuration per spec, not an error). Never commit a real
# secret — treat it as a credential.
KYC_WEBHOOK_URL=
KYC_WEBHOOK_SECRET=
KYC_WEBHOOK_MAX_RETRIES=5
KYC_WEBHOOK_TIMEOUT_SECONDS=10.0

# --------------------------------------------------------------- Redis
# Optional — not currently used now that verification_references and batch
# jobs are SQLite-backed. Kept for a possible future swap.
REDIS_URL=redis://localhost:6379/1
